{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": ".",
      "autoPort": true
    },
    {
      "name": "Artifacts",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "artifacts", "--listen", "4321", "--no-clipboard"],
      "port": 4321
    }
  ]
}
