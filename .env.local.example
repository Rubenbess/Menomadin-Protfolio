# ─── Supabase ────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Portfolio sync (daily Claude refresh → /api/sync/portfolio) ─────────────
# Long random value (32+ chars). Set in Vercel → Project → Settings → Environment
# Variables (Production), then redeploy. Same value goes in the scheduled task.
PORTFOLIO_SYNC_SECRET=
